    # ----- valores <-> interface -----

    def mostrar(self, v):
        _escolha(self.w_tema, self.op_tema, v["tema"])
        _escolha(self.w_botoes, BOTOES, v["botoes"])
        self.w_raio.set_value(v["raio"])
        self.w_sombras.set_active(v["sombras"])
        _escolha(self.w_fonte_nome, self.op_fonte, v["fonte_nome"])
        self.w_fonte_tam.set_value(v["fonte_tam"])
        self.w_espaco.set_value(v["espaco"])
        self.w_foco.set_active(v["foco_mouse"])

        _escolha(self.w_estilo, ESTILOS, v["estilo"])
        self.w_opacidade.set_value(v["opacidade"])
        _escolha(self.w_posicao, POSICOES, v["posicao"])
        self.w_altura.set_value(v["altura"])
        for m, sw in self.w_mod.items():
            sw.set_active(v["modulos"].get(m, False))

        _escolha(self.w_gtk, self.op_gtk, v["gtk"])
        self.w_escuro.set_active(v["escuro"])
        _escolha(self.w_icones, self.op_icones, v["icones"])
        _escolha(self.w_cursor, self.op_cursor, v["cursor"])
        self.w_cursor_tam.set_value(v["cursor_tam"])
        _escolha(self.w_fonte_ui, self.op_fonte_ui, v["fonte_ui"])
        self.w_fonte_ui_tam.set_value(v["fonte_ui_tam"])

        _escolha(self.w_papel, self.op_papel, v["papel"])
        _escolha(self.w_papel_modo, PAPEL_MODOS, v["papel_modo"])

        self.w_layouts.set_text(v["layouts"])
        self.w_variante.set_text(v["variante"])
        _escolha(self.w_modelo, MODELOS, v["modelo"])
        _escolha(self.w_alternar, ALTERNAR, v["alternar"])
        self.w_numlock.set_active(v["numlock"])
        self.w_repeticao.set_value(v["repeticao"])
        self.w_atraso.set_value(v["atraso"])
        self.w_toque.set_active(v["toque"])
        self.w_natural.set_active(v["natural"])
        self.w_digitando.set_active(v["digitando"])
        self.w_velocidade.set_value(v["velocidade"])

        self.w_areas_num.set_value(v["areas_num"])
        self.w_areas_nomes.set_text(v["areas_nomes"])
        self.w_areas_aviso.set_active(v["areas_aviso"])

    def coletar(self):
        a = self.antes
        v = {
            "tema": self._valor_dd(self.w_tema) or a["tema"],
            "botoes": self._valor_dd(self.w_botoes),
            "raio": int(self.w_raio.get_value()),
            "sombras": self.w_sombras.get_active(),
            "fonte_nome": self._valor_dd(self.w_fonte_nome) or a["fonte_nome"],
            "fonte_tam": int(self.w_fonte_tam.get_value()),
            "espaco": int(self.w_espaco.get_value()),
            "foco_mouse": self.w_foco.get_active(),
            "estilo": self._valor_dd(self.w_estilo),
            "opacidade": int(self.w_opacidade.get_value()),
            "posicao": self._valor_dd(self.w_posicao),
            "altura": int(self.w_altura.get_value()),
            "modulos": {m: sw.get_active() for m, sw in self.w_mod.items()},
            "gtk": self._valor_dd(self.w_gtk) or a["gtk"],
            "escuro": self.w_escuro.get_active(),
            "icones": self._valor_dd(self.w_icones) or a["icones"],
            "cursor": self._valor_dd(self.w_cursor) or a["cursor"],
            "cursor_tam": int(self.w_cursor_tam.get_value()),
            "fonte_ui": self._valor_dd(self.w_fonte_ui) or a["fonte_ui"],
            "fonte_ui_tam": int(self.w_fonte_ui_tam.get_value()),
            "papel": self._valor_dd(self.w_papel) or a["papel"],
            "papel_modo": self._valor_dd(self.w_papel_modo),
            "layouts": self.w_layouts.get_text().strip(),
            "variante": self.w_variante.get_text().strip(),
            "modelo": self._valor_dd(self.w_modelo),
            "alternar": self._valor_dd(self.w_alternar),
            "numlock": self.w_numlock.get_active(),
            "repeticao": int(self.w_repeticao.get_value()),
            "atraso": int(self.w_atraso.get_value()),
            "toque": self.w_toque.get_active(),
            "natural": self.w_natural.get_active(),
            "digitando": self.w_digitando.get_active(),
            "velocidade": round(self.w_velocidade.get_value(), 1),
            "areas_num": int(self.w_areas_num.get_value()),
            "areas_nomes": self.w_areas_nomes.get_text().strip(),
            "areas_aviso": self.w_areas_aviso.get_active(),
            "_xkb_opcoes": a.get("_xkb_opcoes", []),
        }
        return v

    def recarregar(self):
        self.antes = valores_atuais()
        self.mostrar(self.antes)
        self.antes = self.coletar()  # o que a tela mostra é a referência do "mudou"
        self.status("✔ Configuração atual carregada." +
                    ("" if labwc_rodando() else " — o labwc não está rodando: as mudanças "
                                                "valem no próximo login."))

    def status(self, texto):
        self.label_status.set_text(texto)
        return False

    # ----- botões -----

    def _botoes(self, ligados):
        for b in (self.b_aplicar, *self.b_restaurar):
            b.set_sensitive(ligados)

    def ao_clicar_aplicar(self, *_):
        v = self.coletar()
        self._botoes(False)

        def tarefa():
            try:
                feito = aplicar(v, self.antes, lambda t: GLib.idle_add(self.status, t))
                GLib.idle_add(self._fim, feito, v, None)
            except Exception as erro:  # noqa: BLE001 - mostra qualquer falha ao usuário
                GLib.idle_add(self._fim, [], v, str(erro))
        threading.Thread(target=tarefa, daemon=True).start()

    def _fim(self, feito, v, erro):
        self._botoes(True)
        if erro:
            self.status(f"⚠️ {erro}")
        elif not feito:
            self.status("ℹ️ Nada mudou.")
        else:
            self.antes = copy.deepcopy(v)
            self.status("✅ Aplicado: " + ", ".join(feito) + ". As janelas continuam abertas.")
        return False

    def confirmar_restaurar(self, base):
        if base == "voidbr":
            msg = "Restaurar o padrão VoidBR?"
            det = ("Atalhos, janelas, teclado, barra, tema, cursor, fonte e papel de parede "
                   "voltam ao padrão do VoidBR.")
        else:
            msg = "Restaurar o padrão do labwc?"
            det = ("O rc.xml volta ao original do labwc: atalhos, tema e menus do próprio "
                   "labwc, sem os do VoidBR. Teclado, barra e papel de parede continuam.")
        det += f"\n\nA configuração atual fica guardada em {BACKUP_DIR}."
        dlg = Gtk.AlertDialog(message=msg, detail=det, buttons=["Cancelar", "Restaurar"],
                              cancel_button=0, default_button=1)
        dlg.choose(self, None, self._resposta_restaurar, base)

    def _resposta_restaurar(self, dlg, res, base):
        try:
            if dlg.choose_finish(res) != 1:
                return
        except GLib.Error:
            return
        self._botoes(False)

        def tarefa():
            try:
                destino = restaurar(base, lambda t: GLib.idle_add(self.status, t))
                GLib.idle_add(self._fim_restaurar, base, destino, None)
            except Exception as erro:  # noqa: BLE001 - mostra qualquer falha ao usuário
                GLib.idle_add(self._fim_restaurar, base, None, str(erro))
        threading.Thread(target=tarefa, daemon=True).start()

    def _fim_restaurar(self, base, destino, erro):
        self._botoes(True)
        if erro:
            self.status(f"⚠️ {erro}")
            return False
        self.recarregar()
        nome = "VoidBR" if base == "voidbr" else "labwc"
        self.status(f"✅ Padrão {nome} restaurado. Backup em {destino}.")
        return False

    def ao_escolher_imagem(self, *_):
        dlg = Gtk.FileDialog(title="Imagem do papel de parede", modal=True)
        filtro = Gtk.FileFilter()
        filtro.set_name("Imagens")
        for ext in PAPEL_EXT:
            filtro.add_pattern("*" + ext)
            filtro.add_pattern("*" + ext.upper())
        filtros = Gio.ListStore.new(Gtk.FileFilter)
        filtros.append(filtro)
        dlg.set_filters(filtros)
        pasta = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES) or PAPEL_PASTA
        if os.path.isdir(pasta):
            dlg.set_initial_folder(Gio.File.new_for_path(pasta))

        def fim(d, res):
            try:
                arq = d.open_finish(res)
            except GLib.Error:
                return
            caminho = arq.get_path()
            if caminho:
                _escolha(self.w_papel, self.op_papel, caminho)
        dlg.open(self, None, fim)

    def abrir_pasta(self, pasta):
        os.makedirs(pasta, exist_ok=True)
        try:
            em_segundo_plano(["xdg-open", pasta])
        except OSError:
            self.status(f"ℹ️ {pasta}")

    # ----- fonte do app -----

    def aplicar_fonte(self):
        nome = Gtk.Settings.get_default().props.gtk_font_name or ""
        m = re.search(r"(\d+(?:\.\d+)?)\s*$", nome)
        base = float(m.group(1)) if m else 11.0
        s = self.escala_fonte
        self.css_fonte.load_from_data((
            f"window, window * {{ font-size: {base * s:.1f}pt; }}\n"
            f".titulo-app {{ font-size: {20 * s:.0f}px; }}\n"
            f".subtitulo {{ font-size: {12 * s:.0f}px; }}\n"
            f".dica {{ font-size: {11 * s:.0f}px; }}\n").encode("utf-8"))
        for w in Gtk.Window.list_toplevels():
            w.queue_resize()
        self.b_escala.set_label(f"{round(s * 100)}%")
        self.b_menor.set_sensitive(s > ESCALA_MIN + 0.001)
        self.b_maior.set_sensitive(s < ESCALA_MAX - 0.001)

    def mudar_fonte(self, passo):
        nova = 1.0 if passo == 0 else round(self.escala_fonte + 0.1 * passo, 2)
        nova = min(ESCALA_MAX, max(ESCALA_MIN, nova))
        if nova == self.escala_fonte and passo:
            return
        self.escala_fonte = nova
        self.aplicar_fonte()
        try:
            gravar_prefs_app(font_scale=nova)
        except OSError:
            pass

    def ao_clicar_sobre(self, *_):
        sobre = Gtk.AboutDialog(transient_for=self, modal=True)
        sobre.set_program_name("VoidBR Labwc Tweaks")
        sobre.set_version(VERSAO)
        sobre.set_comments("Ajustes do labwc do VoidBR:\njanelas, barra em ilha, aparência,\n"
                           "papel de parede, teclado e áreas de trabalho.")
        sobre.set_authors(["Vilmar Catafesta <vcatafesta@gmail.com>"])
        sobre.set_copyright("© 2026 Vilmar Catafesta")
        sobre.set_website("https://voidbr.org")
        sobre.set_website_label("voidbr.org")
        sobre.set_license_type(Gtk.License.BSD)
        sobre.set_logo_icon_name("org.voidbr.LabwcTweaks")
        sobre.present()


class AppTweaks(Gtk.Application):
    def __init__(self, aba=None):
        super().__init__(application_id=APP_ID,
                         flags=getattr(Gio.ApplicationFlags, "DEFAULT_FLAGS",
                                       Gio.ApplicationFlags.FLAGS_NONE))
        self.aba = aba

    def do_activate(self):
        janela = self.props.active_window or JanelaTweaks(self, self.aba)
        janela.present()


def main():
    args = sys.argv[1:]
    if "--version" in args:
        print(f"voidbr-labwc-tweaks {VERSAO}")
        return 0
    if "--help" in args or "-h" in args:
        print("Uso: voidbr-labwc-tweaks [--aba janelas|barra|aparencia|papel|teclado|areas]\n"
              "                           [--padrao-voidbr | --padrao-labwc]")
        return 0
    if "--padrao-voidbr" in args or "--padrao-labwc" in args:
        destino = restaurar("voidbr" if "--padrao-voidbr" in args else "labwc", print)
        print(f"Padrão restaurado. Backup em {destino}")
        return 0
    aba = None
    if "--aba" in args:
        i = args.index("--aba")
        aba = args[i + 1] if i + 1 < len(args) else None
    return AppTweaks(aba).run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
